# Server-side only. Used by the future Pocket AI classification function.
# The browser never reads this file — it uses js/config.js, which holds the
# Supabase URL and anon key (both safe to publish; RLS is what protects data).
#
# The service role key bypasses RLS. It belongs here and nowhere else.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POCKET_AI_API_KEY=
